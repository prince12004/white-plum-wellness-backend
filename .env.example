NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string — put the REAL value only in your local .env, never commit it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-strong-random-secret
REFRESH_TOKEN_TTL=7d

# Separate JWT secrets for the public-site customer (mobile-OTP) login — must be
# different values from the admin secrets above.
CUSTOMER_ACCESS_TOKEN_SECRET=replace-with-strong-random-secret
CUSTOMER_ACCESS_TOKEN_TTL=30m
CUSTOMER_REFRESH_TOKEN_SECRET=replace-with-strong-random-secret
CUSTOMER_REFRESH_TOKEN_TTL=30d

COOKIE_DOMAIN=localhost

# CORS — the two frontend origins allowed to call this API with credentials
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Cloudinary — placeholders, unused until the Media Library phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS/OTP provider for customer mobile login — set EITHER the Twilio Verify trio OR
# the MSG91 pair below. Leave both blank in dev to fall back to a console-logged OTP
# (no real SMS sent, useful for testing the login flow before an SMS account exists).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Seed script — required, no default is provided on purpose
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
